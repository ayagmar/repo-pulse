GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
ADMIN_API_TOKEN=replace-with-admin-bearer-token
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
