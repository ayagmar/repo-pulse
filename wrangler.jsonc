{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repo-pulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    "WEBHOOK_MAX_BODY_BYTES": "1048576",
    // Which webhook deliveries are admitted: repository, app, or both during a cutover.
    // Kept here, not in the dashboard: `wrangler deploy` replaces dashboard vars.
    "GITHUB_WEBHOOK_SOURCES": "app",
    "DELIVERY_MAX_ATTEMPTS": "5",
    "DELIVERY_RETRY_BASE_DELAY_MS": "30000",
    "DELIVERY_RETRY_MAX_DELAY_MS": "900000",
    "DELIVERY_SUCCEEDED_RETENTION_DAYS": "14",
    "DELIVERY_PROCESSING_LEASE_MS": "300000",
    "DELIVERY_DRAIN_BATCH_SIZE": "5",
    "DIGEST_TIME_ZONE": "Africa/Casablanca",
    "DIGEST_HOUR": "9",
    // Close and Label buttons on issue alerts, answered at POST /discord/interactions.
    // `on` needs the Discord application's secrets and an application-owned webhook;
    // see docs/operations.md. `off` keeps alerts without buttons and the route at 404.
    "DISCORD_ACTIONS": "on"
  },
  // Best-effort limit on GET /public/feed per client IP and Cloudflare location.
  "ratelimits": [
    { "name": "FEED_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    // Best-effort limit on POST /discord/interactions, checked before signature work.
    {
      "name": "DISCORD_RATE_LIMIT",
      "namespace_id": "2002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repo-pulse",
      "database_id": "4cc40b77-5edd-42d1-b119-a2ab3dd6ddf5",
      // `npm exec wrangler d1 create repo-pulse` before remote migrations or deployment.
      "migrations_dir": "migrations"
    }
  ]
}
