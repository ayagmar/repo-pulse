{
  "name": "repo-pulse",
  "version": "1.0.0",
  "description": "Cloudflare Workers webhook service for GitHub repository events",
  "packageManager": "npm@12.2.1",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "build": "wrangler deploy --dry-run",
    "typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "benchmark:ledger": "vitest run --config benchmarks/vitest.config.ts",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "audit:prod": "npm audit --omit=dev",
    "audit:full": "npm audit",
    "clean": "rm -rf dist coverage .wrangler",
    "prepare": "husky || true",
    "verify": "run-s typegen typecheck lint check:ci test test:workers knip build",
    "verify:ci": "run-s typegen typecheck lint check:ci test:coverage test:workers knip build"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@vitest/coverage-v8": "^5.0.5",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "biome check --write --no-errors-on-unmatched",
    "src/**/*.{ts,tsx}": "eslint --fix",
    "*.{json,md,yml,yaml}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "better-sqlite3": false
  },
  "cloudflare": {
    "bindings": {
      "GITHUB_WEBHOOK_SECRET": {
        "description": "Random string GitHub signs each webhook delivery with. Generate one with `openssl rand -hex 32` and save a copy: you need the same value for every repository webhook."
      },
      "ADMIN_API_TOKEN": {
        "description": "Bearer token for the `/admin` endpoints. Generate one with `openssl rand -hex 32`."
      },
      "DISCORD_WEBHOOK_URL": {
        "description": "Webhook URL of the Discord channel to post to (Server Settings → Integrations → Webhooks)."
      }
    }
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
